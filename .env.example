# ONE HEALTH GHANA - server-side secrets only.
# Copy to .env.local for local development.
# NEVER commit real keys. NEVER put secrets in NEXT_PUBLIC_* variables.

# ─────────────────────────────────────────────────────────────────────────────
# THE ONE AI KEY. Get it free from Google AI Studio:
#   https://aistudio.google.com/apikey
#
# GEMINI_API_KEY is the entire AI engine of this platform. It powers:
#   1. CHAT + REASONING       - the intelligence desk and every briefing
#   2. THE AGENT              - streaming, tool calling, the full agentic loop
#   3. VISION                 - photos, PDFs, Word, Excel and scans (agent,
#                               Vision Lab, One Health ingest)
#   4. DEEP RESEARCH          - query decomposition and sourced synthesis
#   5. IMAGE GENERATION       - the image_generate tool
#   6. SPEECH-TO-TEXT         - /api/transcribe (audio → verbatim transcript)
#   7. TEXT-TO-SPEECH         - /api/tts (Gemini TTS, ElevenLabs optional)
# One key, one bill, one quota to watch.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Optional - comma-separated Gemini text/vision models tried before the built-in
# chain (gemini-2.5-flash → gemini-2.5-pro → gemini-2.0-flash → flash-latest →
# gemini-2.5-flash-lite → gemma-3-27b-it).
GEMINI_MODELS=
# Optional - comma-separated Gemini image models tried before the built-in chain
GEMINI_IMAGE_MODELS=
# Optional - prebuilt Gemini TTS voice name (default: Kore)
GEMINI_TTS_VOICE=

# Optional - max agentic tool steps per turn (1-24, default 8)
AGENT_MAX_STEPS=

# Optional - live web search with citations (https://tavily.com)
# Powers the AI Agent's web_search, web_fetch, deep_research and image search fallback.
TAVILY_API_KEY=

# Optional - real stock photography for the AI Agent (https://unsplash.com/developers)
# Without it, image_search falls back to Tavily image results.
UNSPLASH_ACCESS_KEY=

# Optional - premium spoken briefings (https://elevenlabs.io).
# Without it, speech falls back to Gemini TTS on the key above.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional - weather context for environmental One Health signals
OPENWEATHER_API_KEY=

# Admin CMS (change after first login)
ADMIN_EMAIL=admin@ghs.gov.gh
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=GHS Administrator
SESSION_SECRET=change-this-long-random-string

# Durable archive (optional). Without this, state lives on the local disk, which
# Render WIPES on every spin-down and redeploy.
# WARNING: a Render *free* Postgres expires 30 days after creation (14-day grace,
# then the data is deleted) and is capped at 1 GB. For real retention use a paid
# Render Postgres or an external provider, plus off-site pg_dump backups.
DATABASE_URL=

# Public site URL (safe to expose)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
