# ONE HEALTH GHANA - server-side secrets only.
# Copy to .env.local for local development.
# NEVER commit real keys. NEVER put secrets in NEXT_PUBLIC_* variables.

# Required for live AI (chat, vision, document reading, forecast briefing)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_HTTP_REFERER=https://one-health-ghana.onrender.com
OPENROUTER_APP_TITLE=ONE HEALTH GHANA
# Optional comma-separated extra model slugs tried first.
# OpenRouter accepts at most THREE slugs per request - the server chunks longer lists.
OPENROUTER_MODELS=

# Optional - live web search with citations (https://tavily.com)
# Powers the AI Agent's web_search, web_fetch, deep_research and image search fallback.
TAVILY_API_KEY=

# Optional - real stock photography for the AI Agent (https://unsplash.com/developers)
# Without it, image_search falls back to Tavily image results.
UNSPLASH_ACCESS_KEY=

# Optional - direct OpenAI key for Whisper speech-to-text.
# Leave empty to route transcription through OpenRouter instead (one key, one bill).
OPENAI_API_KEY=

# The Gemini API key is the platform's primary engine for THREE jobs:
#   1. VISION - reading photos, PDFs and documents in the AI Agent (every mode),
#      the Vision Lab and One Health ingest (https://aistudio.google.com/apikey)
#   2. DEEP RESEARCH - query decomposition and sourced synthesis
#   3. IMAGE GENERATION - the image_generate tool
# OpenRouter stays the reasoning brain for chat; Gemini is what SEES and SYNTHESSES.
GEMINI_API_KEY=

# Optional - comma-specified Gemini text/vision models tried before the built-in chain
GEMINI_MODELS=
# Optional - comma-separated Gemini image models tried before the built-in chain
GEMINI_IMAGE_MODELS=

# Optional - max agentic tool steps per turn (1-24, default 8)
AGENT_MAX_STEPS=

# Optional - spoken briefings (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional - weather context for environmental One Health signals
OPENWEATHER_API_KEY=

# Admin CMS (change after first login)
ADMIN_EMAIL=admin@ghs.gov.gh
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=GHS Administrator
SESSION_SECRET=change-this-long-random-string

# Durable archive (optional). Without this, state lives on the local disk, which
# Render WIPES on every spin-down and redeploy.
# WARNING: a Render *free* Postgres expires 30 days after creation (14-day grace,
# then the data is deleted) and is capped at 1 GB. For real retention use a paid
# Render Postgres or an external provider, plus off-site pg_dump backups.
DATABASE_URL=

# Public site URL (safe to expose)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
