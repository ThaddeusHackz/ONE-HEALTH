# ONE HEALTH GHANA — server-side secrets only.
# Copy to .env.local for local development.
# NEVER commit real keys. NEVER put secrets in NEXT_PUBLIC_* variables.

# Required for live AI (chat, vision, document reading, forecast briefing)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_HTTP_REFERER=https://one-health-ghana.onrender.com
OPENROUTER_APP_TITLE=ONE HEALTH GHANA

# Optional — live web search with citations (https://tavily.com)
TAVILY_API_KEY=

# Optional — spoken briefings (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional — weather context for environmental One Health signals
OPENWEATHER_API_KEY=

# Admin CMS (change after first login)
ADMIN_EMAIL=admin@ghs.gov.gh
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=GHS Administrator
SESSION_SECRET=change-this-long-random-string

# Public site URL (safe to expose)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
